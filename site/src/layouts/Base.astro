---
import '../styles/global.css'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Applied before first paint so a pinned theme never flashes the other one.
      try {
        const saved = localStorage.getItem('codemode-theme')
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved
        }
      } catch {
        /* private mode, storage blocked: fall back to prefers-color-scheme */
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="wordmark" href="/" style="text-decoration:none;color:inherit"
          >codemode<span>-</span>lab</a
        >
        <nav>
          <a href="#race">Race</a>
          <a href="#loses" class="optional">Where it loses</a>
          <a href="#surface" class="optional">Surface</a>
          <a href="#numbers">Numbers</a>
          <button
            class="theme-toggle"
            type="button"
            id="theme-toggle"
            aria-label="Switch between light and dark"
          >
            Theme
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <p>
          codemode-lab measures what MCP code mode costs and saves. Every byte on this page was
          counted in your browser or with curl against a live public server. Token figures are
          estimates from byte counts and are always shown as a band.
        </p>
        <p>
          Measurements dated 21 September 2026. The packages behind this page are
          <code>@codemode-lab/mcp-client</code>, <code>@codemode-lab/meter</code>,
          <code>@codemode-lab/runtime</code> and <code>@codemode-lab/typegen</code>.
        </p>
      </div>
    </footer>

    <script is:inline>
      const toggle = document.getElementById('theme-toggle')
      toggle?.addEventListener('click', () => {
        const root = document.documentElement
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches
        const next = dark ? 'light' : 'dark'
        root.dataset.theme = next
        try {
          localStorage.setItem('codemode-theme', next)
        } catch {
          /* nothing to do: the class on the root still holds for this page */
        }
      })
    </script>
  </body>
</html>
