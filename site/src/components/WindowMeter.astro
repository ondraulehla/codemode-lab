---
import Estimate from './Estimate.astro'
---

<div class="window">
  <div class="window-label">
    <span>context window</span>
    <span data-role="window-pct">idle</span>
  </div>
  <div class="window-track">
    <div class="window-fill" data-role="window-fill"></div>
    <div class="window-ticks"><span></span><span></span><span></span><span></span></div>
    <div class="window-read" data-role="window-read">0 B</div>
  </div>
  <div class="window-scale">
    <span>0</span>
    <span>50K</span>
    <span>100K</span>
    <span>150K</span>
    <span>200K tokens <Estimate /></span>
  </div>
</div>
