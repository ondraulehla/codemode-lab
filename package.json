{
  "name": "codemode-lab-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "harness"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc --build",
    "lab": "node packages/cli/dist/bin.js",
    "fmt": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
