{
  "name": "codemode-lab-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "harness"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc --build",
    "lab": "node packages/cli/dist/bin.js",
    "fmt": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
