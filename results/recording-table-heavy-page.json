  "task": {
    "id": "table-heavy-page",
    "title": "Which page of each dump holds the most table rows?",
    "question": "DeepWiki returns each repository's documentation as one markdown dump. The dump is a series of pages. Every page starts with a line of the form '# Page: <title>'. Count a table row as any line that starts with the pipe character. For cloudflare/agents, e2b-dev/E2B and nodejs/undici, find the page that holds the most table rows. Give the exact page title for each repo, copied character for character, and copy the first table line of that page as evidence.",
    "why": "Three payloads, 1.39 MB of text, about 375,000 to 430,000 estimated tokens, and an answer of about 300 bytes. The direct arm cannot hold even the first two dumps. The rule needs page bodies, not page names, so the cheap structure tool cannot shortcut it.",
    "expectCodeModeWins": true,
    "program": "// Three dumps, 1.39 MB in, about 300 bytes out.\n//\n// The three payloads are fetched concurrently and scanned inside the sandbox. None\n// of them ever reaches the model.\nconst repos = ['cloudflare/agents', 'e2b-dev/E2B', 'nodejs/undici']\n\nconst results = await Promise.all(\n  repos.map(async (repo) => {\n    const dump = await deepwiki.read_wiki_contents({ repoName: repo })\n    const pages = dump.split(/^# Page: /m).slice(1)\n    let best = null\n\n    for (const page of pages) {\n      const title = page.split('\\n', 1)[0].trim()\n      const lines = page.split('\\n')\n      const rows = lines.filter((l) => l.startsWith('|'))\n      if (!best || rows.length > best.rows) {\n        best = { title, rows: rows.length, evidence: rows[0] ?? null }\n      }\n    }\n\n    console.log(`${repo}: ${dump.length} chars, ${pages.length} pages, top page ${best.rows} rows`)\n    return { repo, ...best }\n  }),\n)\n\nreturn results\n",
    "programBytes": 911
  },
  "surface": {
    "rawSchemaBytes": 444,
    "typedSurfaceBytes": 516,
    "typedSurface": "/**\n * Generated from the live tools/list of \"deepwiki\".\n * 1 tool. Do not edit.\n *\n * Every function here runs INSIDE the sandbox and calls OUT over the bridge.\n * Results you do not return never leave the sandbox, which is the point.\n */\ndeclare namespace deepwiki {\n  /**\n   * View documentation about a GitHub repository.\n   */\n  export function read_wiki_contents(args: {\n    /** GitHub repository in owner/repo format (e.g. \"facebook/react\"). */\n    repoName: string\n  }): Promise<{\n    result: string\n  }>\n\n}\n",
    "toolCount": 1
  },
